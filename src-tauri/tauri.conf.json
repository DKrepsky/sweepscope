{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SweepScope",
  "version": "0.1.0",
  "identifier": "io.github.dkrepsky.sweepscope",
  "mainBinaryName": "sweepscope",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SweepScope",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "USB oscilloscope application",
    "longDescription": "SweepScope displays, measures and analyses signals from Hantek 6xx4-series USB oscilloscopes.",
    "license": "MIT",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libusb-1.0-0"
        ],
        "files": {
          "/lib/udev/rules.d/99-hantek6xx4.rules": "../packaging/udev/99-hantek6xx4.rules"
        },
        "postInstallScript": "../packaging/deb/postinst.sh",
        "postRemoveScript": "../packaging/deb/postrm.sh"
      }
    }
  }
}
