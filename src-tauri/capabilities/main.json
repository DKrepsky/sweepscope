{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the registered app commands and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-load-ui-state",
    "allow-save-ui-state",
    "allow-get-snapshot",
    "allow-set-interpolation",
    "allow-export-frame",
    "allow-save-screenshot",
    "allow-save-setup",
    "allow-load-setup",
    "allow-set-running",
    "allow-force-trigger",
    "allow-set-channel",
    "allow-step-setting",
    "allow-reset-setting",
    "allow-set-trigger-position",
    "allow-set-trigger-level",
    "allow-set-trigger",
    "allow-use-simulator",
    "allow-retry-connection",
    "allow-open-frame-stream",
    "allow-close-frame-stream",
    "allow-arm-single",
    "allow-start-autoset",
    "allow-set-math",
    "allow-set-persistence",
    "allow-set-spectrum",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-open-roll-stream",
    "allow-close-roll-stream",
    "allow-open-spectrum-stream",
    "allow-close-spectrum-stream",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
